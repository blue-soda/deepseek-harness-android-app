<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.deepseek.harness"
    android:versionCode="54"
    android:versionName="1.17.5">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 读取已安装应用列表（android_apps / 「打开微信」这类工具依赖）。
         说明：本应用 targetSdk=28，而 Android 11+ 的**应用可见性过滤只作用于 targetSdk≥30**，
         所以现在 getInstalledApplications() 本就能看到全部应用 —— 这条声明当前**是冗余的**，
         属于事前防护：一旦将来把 targetSdk 提到 30+，没有它（或 <queries>）工具会"只看到自己"。
         另：部分国产系统（MIUI/ColorOS 等）会在「应用信息 → 权限」里单独给一个「读取应用列表」
         开关，首启引导的「读取应用列表」页与它对应。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 定时任务：精确闹钟（Android 12+ 需要；setAlarmClock 不受此权限限制，双保险） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 应用可见性（Android 11+，仅对 targetSdk≥30 生效）：显式声明"能看到所有带启动入口的应用"。
         与上面的 QUERY_ALL_PACKAGES 互为备份 —— 后者在 Google Play 上属于敏感权限，
         若将来要上架可以只保留这段 queries；自签侧载则两者都留着更稳。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- 鍘熸潵鍐欑殑鏄?unspecified锛?銆屼笉琛ㄦ€侊紝绯荤粺鐪嬬潃鍔炪€嶏級锛岀湡鏈鸿〃鐜颁负娌跨敤褰撳墠灞忓箷鏃嬭浆锛?             浠庢í灞忕殑娓告垙/瑙嗛鍒囧洖鏉ヤ粛鏄í灞忥紙璺熼殢鐨勬槸涓婁竴涓簲鐢紝鑰屼笉鏄郴缁熻缃級銆?             fullUser锛氱郴缁熴€岃嚜鍔ㄦ棆杞€嶅紑鐫€ 鈫?璺熼殢閲嶅姏鎰熷簲锛堝惈鍙嶅悜妯珫灞忥級锛?             鍏崇潃锛堥攣瀹氭柟鍚戯級鈫?璺熼殢鐢ㄦ埛閿佸畾銆?
             configChanges 琛ラ綈 smallestScreenSize|screenLayout锛坕ssue #37锛岀ぞ鍖?@zf-666888 鎶ュ憡锛夛細
             鍘熶负 orientation|screenSize|keyboardHidden锛岀己杩欎袱椤规椂锛屽钩鏉垮垎灞?/ 鑷敱绐楀彛鎷栧姩
             鍒嗛殧鏉¤皟鏁存瘮渚?鈫?绯荤粺涓嬪彂鐨勬鏄?CONFIG_SCREEN_LAYOUT + CONFIG_SMALLEST_SCREEN_SIZE
             鈫?娌″０鏄庡氨涓嶅綊 App 澶勭悊 鈫?绯荤粺鐩存帴閿€姣侀噸寤?MainActivity
             锛堟柊寤?WebView 閲嶆柊 loadUrl + 鍚姩椤电洊涓婃潵 = 鐢ㄦ埛鐪嬪埌鐨勩€岀櫧闂竴涓?+ 閲嶆斁鍚姩椤点€嶏級銆?             寮曟搸鏄嫭绔?node 杩涚▼ + EngineService 淇濇椿锛屾墍浠ラ噸寤烘潃涓嶅埌瀹冿紝
             琛ㄧ幇涓恒€屼細璇濊繘搴︽病鏂€佸彧鏄晫闈㈤棯銆嶃€?             鐪熸満瀹炶瘉锛圤nePlus OPD2413 / ColorOS 16 / Android 16锛夛細dumpsys 閲?configChanges=0x4a3
             锛? ORIENTATION|SCREEN_SIZE|KEYBOARD_HIDDEN锛岀‘瀹炰笉鍚?SCREEN_LAYOUT 0x100 /
             SMALLEST_SCREEN_SIZE 0x800锛夛紱logcat 閲?ActivityRecordExtImpl: hookShouldRelaunchLocked
             reason: adjustedChanges={CONFIG_ORIENTATION, CONFIG_SCREEN_LAYOUT,
             CONFIG_SMALLEST_SCREEN_SIZE}銆?             鈿狅笍 鏁呮剰**涓?*鍔?uiMode / density / fontScale 鈥斺€?璺熼殢绯荤粺娣辨祬鑹层€佹樉绀哄ぇ灏忋€佸瓧浣撳ぇ灏?             姝ｆ槸闈犮€岄噸寤?鈫?onCreate 鐨?setTheme() 閲嶆柊鐢熸晥銆嶏紝鍔犺繘鍘诲弽鑰屼細璁╀富棰樹笉鍐嶈窡闅忋€?-->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/AppTheme">
            <!-- 鍘熶富棰?Theme.Black.NoTitleBar.Fullscreen 浼氶殣钘忕姸鎬佹爮锛?                 閮ㄥ垎 ROM锛堝 ColorOS锛夎繕浼氭妸绐楀彛鏁翠綋涓嬬Щ锛岄《閮ㄩ湶鍑轰竴鍧楅粦鏉°€?                 鏀逛负 res/values/styles.xml 鐨?AppTheme锛堢埗涓婚 Theme.Black.NoTitleBar锛?                 涓嶉殣钘忕姸鎬佹爮锛岀姸鎬佹爮/瀵艰埅鏍忓簳鑹茶窡闅忎富棰橈級銆?-->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 鍓嶅彴淇濇椿鏈嶅姟锛氬紩鎿庤繍琛屾湡闂村父椹婚€氱煡鏍忥紝鎸傚悗鍙颁笉琚潃 -->
        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 灏忛哺楸兼偓娴獥锛堝惈寮曟搸鐘舵€佹樉绀猴級 -->
        <service
            android:name=".OverlayService"
            android:exported="false" />

        <!-- 铏氭嫙灞忔帴鍏ユˉ锛氬惎鍔?Operit server + HTTP->binder 杞彂锛堟彃浠?API锛?-->
