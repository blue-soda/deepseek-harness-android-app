<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.deepseek.harness"
    android:versionCode="52"
    android:versionName="1.17.3">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 读取已安装应用列表（android_apps / 「打开微信」这类工具依赖）。
         说明：本应用 targetSdk=28，而 Android 11+ 的**应用可见性过滤只作用于 targetSdk≥30**，
         所以现在 getInstalledApplications() 本就能看到全部应用 —— 这条声明当前**是冗余的**，
         属于事前防护：一旦将来把 targetSdk 提到 30+，没有它（或 <queries>）工具会"只看到自己"。
         另：部分国产系统（MIUI/ColorOS 等）会在「应用信息 → 权限」里单独给一个「读取应用列表」
         开关，首启引导的「读取应用列表」页与它对应。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 定时任务：精确闹钟（Android 12+ 需要；setAlarmClock 不受此权限限制，双保险） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 应用可见性（Android 11+，仅对 targetSdk≥30 生效）：显式声明"能看到所有带启动入口的应用"。
         与上面的 QUERY_ALL_PACKAGES 互为备份 —— 后者在 Google Play 上属于敏感权限，
         若将来要上架可以只保留这段 queries；自签侧载则两者都留着更稳。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- 原来写的是 unspecified（=「不表态，系统看着办」），真机表现为沿用当前屏幕旋转：
             从横屏的游戏/视频切回来仍是横屏（跟随的是上一个应用，而不是系统设置）。
             fullUser：系统「自动旋转」开着 → 跟随重力感应（含反向横竖屏）；
             关着（锁定方向）→ 跟随用户锁定。

             configChanges 补齐 smallestScreenSize|screenLayout（issue #37，社区 @zf-666888 报告）：
             原为 orientation|screenSize|keyboardHidden，缺这两项时，平板分屏 / 自由窗口拖动
             分隔条调整比例 → 系统下发的正是 CONFIG_SCREEN_LAYOUT + CONFIG_SMALLEST_SCREEN_SIZE
             → 没声明就不归 App 处理 → 系统直接销毁重建 MainActivity
             （新建 WebView 重新 loadUrl + 启动页盖上来 = 用户看到的「白闪一下 + 重放启动页」）。
             引擎是独立 node 进程 + EngineService 保活，所以重建杀不到它，
             表现为「会话进度没断、只是界面闪」。
             真机实证（OnePlus OPD2413 / ColorOS 16 / Android 16）：dumpsys 里 configChanges=0x4a3
             （= ORIENTATION|SCREEN_SIZE|KEYBOARD_HIDDEN，确实不含 SCREEN_LAYOUT 0x100 /
             SMALLEST_SCREEN_SIZE 0x800）；logcat 里 ActivityRecordExtImpl: hookShouldRelaunchLocked
             reason: adjustedChanges={CONFIG_ORIENTATION, CONFIG_SCREEN_LAYOUT,
             CONFIG_SMALLEST_SCREEN_SIZE}。
             ⚠️ 故意**不**加 uiMode / density / fontScale —— 跟随系统深浅色、显示大小、字体大小
             正是靠「重建 → onCreate 的 setTheme() 重新生效」，加进去反而会让主题不再跟随。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/AppTheme">
            <!-- 原主题 Theme.Black.NoTitleBar.Fullscreen 会隐藏状态栏，
                 部分 ROM（如 ColorOS）还会把窗口整体下移，顶部露出一块黑条。
                 改为 res/values/styles.xml 的 AppTheme（父主题 Theme.Black.NoTitleBar，
                 不隐藏状态栏，状态栏/导航栏底色跟随主题）。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台保活服务：引擎运行期间常驻通知栏，挂后台不被杀 -->
        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 小鲸鱼悬浮窗（含引擎状态显示） -->
        <service
            android:name=".OverlayService"
            android:exported="false" />

        <!-- 虚拟屏接入桥：启动 Operit server + HTTP->binder 转发（插件 API） -->
        <service
            android:name=".VsreenBridgeService"
            android:exported="false" />

        <!-- v1.7 无障碍服务：AI 读屏 + 模拟操作 + 无障碍截图（用户需在系统设置开启） -->
        <service
            android:name=".AccessibilityService"
            android:exported="false"
            android:label="DeepSeek Harness 屏幕助手"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.deepseek.harness.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- v1.13：「分享日志」以**文件**形式发出（targetSdk 28 不允许直传 file:// URI，
             本项目无 androidx，故自实现最小只读 ContentProvider，只暴露 cache/share 下的文件） -->
        <provider
            android:name=".LogShareProvider"
            android:authorities="com.deepseek.harness.logshare"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
