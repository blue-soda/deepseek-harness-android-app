            android:exported="false" />

        <!-- v1.19.6 · A2：AI 浏览器宿主（独立进程 :browser）——
             页面把 WebView 搞崩时只死这个进程，主界面与引擎不受影响；关掉浏览器即松绑，整进程可被回收 -->
        <service
            android:name=".BrowserService"
            android:exported="false"
            android:process=":browser" />

        <!-- v1.7 无障碍服务（服务名乱码还原）：AI 读屏 + 模拟操作 + 无障碍截图（用户需在系统设置开启） -->
        <service
            android:name=".AccessibilityService"
            android:exported="false"
            android:label="DeepSeek Harness 屏幕助手"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.deepseek.harness.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- v1.13锛氥€屽垎浜棩蹇椼€嶄互**鏂囦欢**褰㈠紡鍙戝嚭锛坱argetSdk 28 涓嶅厑璁哥洿浼?file:// URI锛?             鏈」鐩棤 androidx锛屾晠鑷疄鐜版渶灏忓彧璇?ContentProvider锛屽彧鏆撮湶 cache/share 涓嬬殑鏂囦欢锛?-->
